{
  "manifest_version": 3,
  "name": "UndipGampang - UNDIP Schedule & Theme Suite",
  "version": "2.0.0",
  "description": "Ekstrak Jadwal Kuliah SIAP UNDIP ke Google Calendar (.ics) & Customizer Tema, Wallpaper, Foto Profil, dan Widget Interaktif.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://siap.undip.ac.id/*",
        "https://form.undip.ac.id/*",
        "file:///*"
      ],
      "js": [
        "scripts/parser.js",
        "scripts/ics-generator.js",
        "scripts/content.js",
        "scripts/customizer-engine.js",
        "scripts/form-captcha-helper.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
